{
  "name": "the-journal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test lib/articles.test.ts tests/validation.test.ts tests/cms.test.ts tests/backup.test.mjs",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:admin": "node scripts/test-admin-session.mjs",
    "test:performance": "node scripts/performance-audit.mjs",
    "test:load": "node scripts/load-check.mjs",
    "backup:create": "node scripts/backup.mjs",
    "backup:verify": "node scripts/restore-drill.mjs",
    "backup:media": "node scripts/test-admin-session.mjs --backup-only",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@tiptap/extension-highlight": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/extension-text-style": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "15.5.28",
    "postcss": "8.5.31",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "remark-parse": "11.0.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.3.1",
    "tus-js-client": "4.3.1",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.28",
    "lighthouse": "13.5.0",
    "tailwindcss": "4.1.11",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "overrides": {
